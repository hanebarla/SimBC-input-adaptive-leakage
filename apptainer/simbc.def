Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

%labels
    org.opencontainers.image.title SimBC Input-Adaptive Leakage
    org.opencontainers.image.source https://github.com/hanebarla/SimBC-input-adaptive-leakage
    org.opencontainers.image.base.name nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
    org.opencontainers.image.licenses BSD-2-Clause AND AGPL-3.0-only

%files
    LICENSE /opt/simbc/LICENSE
    README.md /opt/simbc/README.md
    pyproject.toml /opt/simbc/pyproject.toml
    setup.py /opt/simbc/setup.py
    robo_manip_baselines /opt/simbc/robo_manip_baselines
    scripts /opt/simbc/scripts
    third_party/eipl /opt/simbc/third_party/eipl

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        git \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libglvnd0 \
        libosmesa6 \
        libsm6 \
        libx11-6 \
        libxcb1 \
        libxext6 \
        python3.10 \
        python3.10-dev \
        python3-pip \
        python-is-python3 \
        ripgrep
    rm -rf /var/lib/apt/lists/*

    python3.10 -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python3.10 -m pip install --no-cache-dir \
        torch==2.11.0 \
        torchvision==0.26.0 \
        --index-url https://download.pytorch.org/whl/cu128
    python3.10 -m pip install --no-cache-dir /opt/simbc/third_party/eipl
    python3.10 -m pip install --no-cache-dir "/opt/simbc[sarnn]"
    python3.10 -m pip install --no-cache-dir \
        pre-commit==4.2.0 \
        pytest==8.3.5 \
        ruff==0.8.0
    python3.10 -m pip install --no-cache-dir "setuptools<82"

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export MPLBACKEND=Agg
    export MUJOCO_GL=egl
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONUNBUFFERED=1

%runscript
    exec python3.10 "$@"

%test
    python3.10 /opt/simbc/scripts/smoke_test.py --cpu
